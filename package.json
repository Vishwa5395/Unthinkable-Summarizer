{
  "name": "unthinkable-summarizer",
  "version": "1.0.0",
  "description": "Intelligent multimodal document analysis and summarization platform",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <=22.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "start": "node server/dist/server.js",
    "test": "npm run test --prefix server"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-darwin-arm64": "^1.0.8",
    "@napi-rs/canvas-darwin-x64": "^1.0.8",
    "@napi-rs/canvas-linux-arm64-gnu": "^1.0.8",
    "@napi-rs/canvas-linux-x64-gnu": "^1.0.8",
    "@napi-rs/canvas-linux-x64-musl": "^1.0.8",
    "@napi-rs/canvas-win32-x64-msvc": "^1.0.8"
  },
  "keywords": [
    "document-summarizer",
    "multimodal",
    "ocr",
    "pdf-analysis",
    "vision",
    "ai"
  ],
  "author": "Unthinkable Team",
  "license": "MIT"
}
