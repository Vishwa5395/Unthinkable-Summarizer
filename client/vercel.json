{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev --include=optional",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://unthinkable-summarizer.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
