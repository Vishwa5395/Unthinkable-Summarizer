# ==============================================================================
# UNTHINKABLE SUMMARIZER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
# If local MongoDB is running: mongodb://localhost:27017/unthinkable_summarizer
# If MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/unthinkable_summarizer
MONGODB_URI=mongodb://localhost:27017/unthinkable_summarizer

# Authentication & Security
JWT_SECRET=unthinkable_super_secret_jwt_key_min_32_chars_long_12345
JWT_EXPIRES_IN=7d
ANONYMOUS_SESSION_TTL_HOURS=24

# Document Upload & Processing
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_REQUEST=5
UPLOAD_TEMP_DIR=uploads/temp
MAX_CONCURRENT_DOCUMENTS=2
MAX_CONCURRENT_AI_REQUESTS=1

# ==============================================================================
# Document Extraction & Layout Preservation (Primary: LLMWhisperer, Secondary: Local)
# ==============================================================================
# EXTRACTION_PROVIDER options: 'auto' (default), 'llmwhisperer', 'local'
# In 'auto' mode: LLMWhisperer is PRIMARY when key is present, LocalFallback is SECONDARY.
EXTRACTION_PROVIDER=auto
LLMWHISPERER_API_KEY=
LLMWHISPERER_BASE_URL=https://llmwhisperer-api.us-central.unstract.com/api/v2
LLMWHISPERER_TIMEOUT_MS=120000
LLMWHISPERER_MAX_RETRIES=1
LLMWHISPERER_MAX_CONCURRENT=2
LLMWHISPERER_POLL_INTERVAL_MS=2000
EXTRACTION_CACHE_MAX_ENTRIES=100
EXTRACTION_CACHE_TTL_HOURS=24

# ==============================================================================
# Hybrid AI / ML Summarization & Q&A Strategy
# ==============================================================================
# Operational Modes:
# 1. 'deterministic' - Zero API key required, 100% offline rule-based & extractive NLP + local OCR.
# 2. 'openai-compatible' - Uses external LLM/VLM for advanced structured reasoning.
# If AI_PROVIDER is set to openai-compatible but calls fail or key is empty, the system automatically falls back to deterministic.
AI_PROVIDER=deterministic
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_RETRIES=2

# Local OCR Engine Configuration (Fallback Provider)
OCR_PROVIDER=tesseract
OCR_CONFIDENCE_THRESHOLD=60
OCR_ENABLE_HANDWRITING_ENHANCEMENT=true
